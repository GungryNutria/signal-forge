# Nombres de las variables de entorno. Sin valores: nunca subas valores reales.
# Ninguna es NEXT_PUBLIC_*. Se validan con zod en src/server/env.ts.
DATABASE_URL=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Debe ser https://paper-api.alpaca.markets
APCA_API_BASE_URL=
DASHBOARD_USUARIO=
DASHBOARD_CONTRASENA=
# SHA-256 (hex) del token del investigador; ver scripts/generar-token.mjs
INVESTIGADOR_TOKEN_SHA256=
# Opcional. SHA-256 (hex) del token del decisor (sfd_...); ver `node scripts/generar-token.mjs --decisor`.
# Ausente o invalido: ningun token es del decisor y sus rutas dan 401. No lo valida esquemaEnv.
DECISOR_TOKEN_SHA256=
# true | false
TRADING_PAUSADO=
# produccion | desarrollo | test
APP_ENV=
# Opcional, entero >= 1, por defecto 1: tope de entradas abiertas por activo (R11).
# No lo lee el vigilante; un valor invalido detiene solo las entradas nuevas.
MAX_ENTRADAS_ABIERTAS_POR_ACTIVO=

# Opcionales. ejecuta | solo_registra | apagado. Por defecto MODO_CICLO=ejecuta y MODO_DECISOR=apagado.
# Con los dos en ejecuta ninguno ejecuta (REQ-16). No los lee el vigilante; un valor invalido detiene solo al ciclo.
# Con el ciclo en solo_registra evalua y guarda la senal sin proponer; apagado no registra ejecucion.
MODO_CICLO=
MODO_DECISOR=

# Solo para los tests de integracion (no es parte de la app).
# Debe apuntar a una base desechable cuyo nombre contenga "test": el arnes
# recrea el esquema public.
# TEST_DATABASE_URL=
